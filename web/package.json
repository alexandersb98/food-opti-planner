{
  "name": "meal-planner-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "gen:api": "cd .. && python3 -m server.export_openapi web/openapi.json && cd web && openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "sass-embedded": "^1.106.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
